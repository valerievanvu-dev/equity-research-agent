OPENAI_API_KEY=sk-...
# Only needed if you run Claude models (agent or judge)
# ANTHROPIC_API_KEY=sk-ant-...
# SEC requires every automated client to identify itself: "Name contact@email"
SEC_USER_AGENT=Your Name you@example.com
PARALLEL_API_KEY=...
# Judge defaults to an OpenAI model so a Claude agent isn't graded by itself
EQR_JUDGE_MODEL=gpt-5.5
# Optional: agent model (default gpt-6.2-astra)
EQR_MODEL=gpt-6.2-astra

# Optional: email the PDF after every run (see README)
# EQR_EMAIL_TO=you@example.com
# EQR_SMTP_USER=you@example.com
# EQR_SMTP_PASSWORD=app-password
# Or send through the Mail app on macOS (no password):
# EQR_EMAIL_METHOD=macos-mail
# Or Resend (easiest; free tier):
# EQR_EMAIL_METHOD=resend
# RESEND_API_KEY=re_...
